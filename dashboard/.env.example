# Server-side only. Nothing here reaches the browser.

# The API this dashboard talks to.
TASTE_API_URL=http://localhost:8080
# An admin-scoped API key. Used only on behalf of a signed-in admin.
TASTE_ADMIN_KEY=tk_...
# The /admin password and the secret that signs its session cookie. Use long random values.
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
# Same value as DASHBOARD_PROXY_SECRET on the API, so rate limits see the browser's address.
DASHBOARD_PROXY_SECRET=
# Time zone for timestamps on the admin pages.
DASHBOARD_TZ=UTC
