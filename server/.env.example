# Copy to .env for local runs. On Railway, set these as service variables on both api and worker.

# Required
DATABASE_URL=postgresql://postgres@localhost:5432/taste
OPENAI_API_KEY=sk-...

# First boot only: creates an admin API key if none exist. tk_ followed by at least 37 random characters,
# e.g. python -c "import secrets; print('tk_' + secrets.token_urlsafe(32))"
ADMIN_BOOTSTRAP_KEY=

# Object storage for screenshots and video keyframes (any S3-compatible bucket: Railway, R2, MinIO).
# Named S3_* rather than AWS_*, because AWS_* variables leak into Railway's image builder.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Hosted iMessage number via Blooio. Leave empty to use only the relay API.
BLOOIO_API_KEY=
BLOOIO_NUMBER=
BLOOIO_WEBHOOK_SECRET=

# Dashboard
DASHBOARD_URL=http://localhost:3000
DASHBOARD_ORIGIN=
DASHBOARD_PROXY_SECRET=

# Optional
TASTE_MODEL=gpt-5.6-luna
TASTE_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TASTE_DEFAULT_TZ=UTC
CLIENT_IP_HEADER=x-real-ip
WORKER_CONCURRENCY=2
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YTDLP_PROXY=
YTDLP_COOKIES_B64=
